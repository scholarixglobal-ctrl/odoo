<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Settings View for Voice Assistant -->
        <record id="view_res_config_settings_voice_assistant" model="ir.ui.view">
            <field name="name">res.config.settings.voice.assistant</field>
            <field name="model">res.config.settings</field>
            <field name="priority">35</field>
            <field name="arch" type="xml">
                <form string="Settings" class="oe_form_configuration">
                    <app data-key="voice_assistant" string="Voice Assistant" groups="base.group_system"/>
                    <block title="OpenAI Configuration" name="openai_config">
                        <setting help="Your OpenAI API Key from https://platform.openai.com/api-keys">
                            <label for="openai_api_key"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="openai_api_key" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting>
                            <label for="openai_model"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="openai_model"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </form>
            </field>
        </record>
    </data>
</odoo>
